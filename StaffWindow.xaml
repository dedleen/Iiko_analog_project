<Window x:Class="Kvalif.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kvalif"
        mc:Ignorable="d"
        Title="StaffWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="UserDataGrid" AutoGenerateColumns="False" ItemsSource="{Binding}" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" IsReadOnly="True" />
                <DataGridTextColumn Header="Имя пользователя" Binding="{Binding Username}" />
                <DataGridTextColumn Header="Код" Binding="{Binding Code}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" />
                <DataGridTextColumn Header="Активность" Binding="{Binding Activity}" />
                <DataGridTemplateColumn Header="Удалить">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить" Click="DeleteUser_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Экспорт в Excel" Margin="10" HorizontalAlignment="Right" Width="150" Click="ExportToExcel_Click"/>
        <Button Grid.Row="1" Content="Сохранить изменения" Click="SaveChanges_Click" Margin="0,10,0,0"/>
    </Grid>
</Window>
