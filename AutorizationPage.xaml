<Page x:Class="Kvalif.AutorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvalif"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Grid  Grid.Row="0">
            <TextBlock Text="Введите код:" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox Name="txtCode" Grid.Row="0" Margin="0,100,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="200" Height="30" TextAlignment="Center" FontSize="20"/>
            </Grid>
        
            <Button Content="Войти" Grid.Row="1" MinHeight="40" VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="200" Margin="0,50,0,25" Click="Button_Click"/>
        </StackPanel>
       
    </Grid>
</Page>
