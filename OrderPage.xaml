<Page x:Class="Kvalif.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvalif"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Список блюд -->
            <ColumnDefinition Width="3*"/>
            <!-- Пустая центральная часть -->
            <ColumnDefinition Width="2*"/>
            <!-- Категории и поиск -->
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Список блюд и итог -->
        <StackPanel Grid.Column="0" Margin="10">
            <ListBox x:Name="DishesListBox" Height="450">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DishName}" Width="150"/>
                            <TextBlock Text=" - " Width="10"/>
                            <TextBlock Text="{Binding Price}" Width="50" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Состояние 1: Добавлено, не отправлено -->
                                <Button x:Name="DeleteButton" Content="Удалить" />

                                <Button x:Name="AcceptButton" Content="Подано"/>
                                <TextBlock Text="Время"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Итог под списком блюд -->
            <StackPanel Background="LightGray" Height="50" Margin="0,10,0,0">
                <TextBlock Text="Итог:" HorizontalAlignment="Right" Margin="0,10,10,0"/>
                <TextBlock x:Name="TotalPrice" Text="0.00 Р" FontSize="16" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Правая колонка: Категории и поиск -->
        <StackPanel Grid.Column="2" Margin="10">
            <TextBox x:Name="Find" Margin="0,0,0,10"/>

        </StackPanel>
    </Grid>
</Page>
