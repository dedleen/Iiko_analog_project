<Page x:Class="Kvalif.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvalif.Converters"
    mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">
    <Page.Resources>
        <local:BooleanToServedConverter x:Key="BooleanToServedConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

      
        <StackPanel Grid.Column="0" Margin="10">
            <WrapPanel>
               <Button Content="Назад"
                    HorizontalAlignment="Left"
                    Foreground="White"
                    Background="Gray"
                    Padding="10"
                    Click="BackButton_Click"
                />
                <Button Content="Кол-во"
                        FontSize="12"
                        Padding="10"
                        Foreground="White"
                        Background="Gray"
                        Margin="1,0,1,0"
                        Click="ChangeQuantity_Click"
                    />  
            </WrapPanel>

            <ListBox x:Name="DishesListBox" ItemsSource="{Binding OrderItems}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DishName}" Width="150"/>
                            <TextBlock Text="{Binding Price}" Width="80"/>
                            <CheckBox IsChecked="{Binding IsServed}" Content="Подача"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Background="LightGray" Height="50" Margin="0,10,0,0">
                <TextBlock Text="Итог:" HorizontalAlignment="Right" Margin="0,10,10,0"/>
                <TextBlock x:Name="TotalPrice" Text="0.00 Р" FontSize="16" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                
            </StackPanel>
            <Frame x:Name="CategoryFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>            

        </Grid>
        <StackPanel Grid.Column="2" Margin="10">
            <TextBox x:Name="Find" Margin="0,0,0,10" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Сформировать пречек"
                    Background="Gray"
                    Foreground="White"
                    Padding="10"
                    Click="GeneratePrecheck_Click"
                
                />
            <Button Content="Закрыть заказ"
                Background="DarkRed"
                Foreground="White"
                Margin="0,5"
                Padding="10"
                Click="CloseOrder_Click"/>
        </StackPanel>
    </Grid>
</Page>