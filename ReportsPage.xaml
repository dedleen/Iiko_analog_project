<Page x:Class="Kvalif.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvalif"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportsPage">

    <StackPanel Margin="20">
        <TextBlock Text="Отчеты" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Button Content="Отчет по выручке" Click="RevenueReport_Click" Margin="0,0,0,10"/>
        <Button Content="Статистика по официантам" Click="WaiterStatsReport_Click" Margin="0,0,0,10"/>
    </StackPanel>
</Page>
