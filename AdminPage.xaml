<Page x:Class="Kvalif.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvalif"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
            <Button Content="Заказы" Background="Gray" Foreground="Wheat" Click="OrdersButton_Click" Height="40" Margin="0,5" />
            <Button Content="Отчеты" Background="Gray" Foreground="Wheat" Click="ReportsButton_Click" Height="40" Margin="0,5"/>
            <Button Content="Персонал" Background="Gray" Foreground="Wheat" Click="StaffButton_Click" Height="40" Margin="0,5"/>
        </StackPanel>
    </Grid>
</Page>
